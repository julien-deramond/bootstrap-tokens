            "sassKey": "primary",
            "sassSubKey": "bg-muted",
            "sassQuoted": true,
            "dark": "{color.blue.800}"
          }
        },
        "$description": "A stronger tint than `bg-subtle`, for hover and active states on tinted surfaces."
      },
      "border": {
        "$type": "color",
        "$value": "{color.blue.300}",
        "$extensions": {
          "dev.bootstrap.tokens": {
            "cssVar": "--primary-border",
