            "sassKey": "primary",
            "sassSubKey": "fg",
            "sassQuoted": true,
            "dark": "{color.blue.400}"
          }
        },
        "$description": "Primary text on the page background — darkened in light mode and lightened in dark, so it stays readable in both."
      },
      "fg-emphasis": {
        "$type": "color",
        "$value": "{color.blue.800}",
