            "sassKey": "primary",
            "sassSubKey": "border",
            "sassQuoted": true,
            "dark": "{color.blue.600}"
          }
        },
        "$description": "A primary border against the page background — tinted enough to read as primary, calm enough not to compete with the fill."
      },
      "focus-ring": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.blue.500} 50%, {bg.body})",
