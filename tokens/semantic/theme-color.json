            "sassSubKey": "bg-subtle",
            "sassQuoted": true,
            "dark": "{color.blue.900}"
          }
        },
        "$description": "A lightly tinted primary surface — the usual background for alerts and subtle badges."
      },
      "bg-muted": {
        "$type": "color",
        "$value": "{color.blue.200}",
        "$extensions": {
          "dev.bootstrap.tokens": {
            "cssVar": "--primary-bg-muted",
