          "dev.bootstrap.tokens": {
            "cssVar": "--primary-base",
            "sassMap": "$theme-colors",
            "sassKey": "primary",
            "sassSubKey": "base",
            "sassQuoted": true
          }
        },
        "$description": "The solid primary colour, unmodified. Use it when you need the hue itself rather than a surface or a text role."
      },
      "fg": {
        "$type": "color",
        "$value": "{color.blue.600}",
        "$extensions": {
          "dev.bootstrap.tokens": {
            "cssVar": "--primary-fg",
