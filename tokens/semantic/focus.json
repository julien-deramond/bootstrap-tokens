{
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--focus-ring-width",
          "sassMap": "$root-tokens",
          "sassKey": "--focus-ring-width"
        }
      },
      "$description": "Thickness of the focus ring. Do not go below 2px: this is the only cue a keyboard user gets."
    },
    "offset": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--focus-ring-offset",
          "sassMap": "$root-tokens",
          "sassKey": "--focus-ring-offset"
        }
      },
      "$description": "Gap between a control and its focus ring, so the ring stays legible against the control."
    },
    "color": {
      "$type": "color",
      "$value": "{theme-color.primary.focus-ring}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--focus-ring-color",
          "sassMap": "$root-tokens",
          "sassKey": "--focus-ring-color"
        }
      },
      "$description": "Colour of the focus ring. Follows the primary role by default."
    },
    "ring": {
      "$value": "{focus.width} solid {focus.color}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--focus-ring",
          "sassMap": "$root-tokens",
          "sassKey": "--focus-ring",
          "expression": true
        }
      },
      "$description": "The whole focus ring shorthand, composed from the width and colour above."
    },
    "$description": "Focus ring geometry and colour."
  }
}
