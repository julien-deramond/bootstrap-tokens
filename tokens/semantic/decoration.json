{
  "decoration": {
    "gradient": {
      "$value": "linear-gradient(180deg, color-mix({color.white} 15%, transparent), color-mix({color.white} 0%, transparent))",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--gradient",
          "sassVar": "$gradient",
          "sassEmit": "#{$gradient}",
          "expression": true
        }
      }
    },
    "$description": "Decorative effects that are not colour, spacing or type."
  }
}
