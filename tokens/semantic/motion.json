{
  "motion": {
    "timing-overlay": {
      "$type": "cubicBezier",
      "$value": [
        0.22,
        1,
        0.36,
        1
      ],
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--transition-timing-overlay",
          "sassMap": "$root-tokens",
          "sassKey": "--transition-timing-overlay"
        }
      },
      "$description": "Shared easing for overlays — dialogs, drawers and menus — so they all enter with the same character."
    },
    "$description": "Shared easing curves."
  }
}
