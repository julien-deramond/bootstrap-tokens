{
  "bg": {
    "1": {
      "$type": "color",
      "$value": "{color.gray.025}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-1",
          "sassMap": "$theme-bgs",
          "sassKey": "1",
          "sassQuoted": true,
          "dark": "{color.gray.950}"
        }
      },
      "$description": "The first raised surface — card headers, table stripes, anything a step above the page."
    },
    "2": {
      "$type": "color",
      "$value": "{color.gray.050}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-2",
          "sassMap": "$theme-bgs",
          "sassKey": "2",
          "sassQuoted": true,
          "dark": "{color.gray.900}"
        }
      },
      "$description": "A second step up, for a surface raised above one that is already raised."
    },
    "3": {
      "$type": "color",
      "$value": "{color.gray.100}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-3",
          "sassMap": "$theme-bgs",
          "sassKey": "3",
          "sassQuoted": true,
          "dark": "{color.gray.800}"
        }
      },
      "$description": "A third step, used mostly for disabled controls and inset wells."
    },
    "4": {
      "$type": "color",
      "$value": "{color.gray.200}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-4",
          "sassMap": "$theme-bgs",
          "sassKey": "4",
          "sassQuoted": true,
          "dark": "{color.gray.700}"
        }
      },
      "$description": "The strongest neutral fill before you reach an inverted surface."
    },
    "body": {
      "$type": "color",
      "$value": "{color.white}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-body",
          "sassMap": "$theme-bgs",
          "sassKey": "body",
          "sassQuoted": true,
          "dark": "{color.gray.975}"
        }
      },
      "$description": "The page background. Every other surface is measured against it."
    },
    "fg": {
      "$type": "color",
      "$value": "{fg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-fg",
          "sassMap": "$theme-bgs",
          "sassKey": "fg",
          "sassQuoted": true
        }
      },
      "$description": "The foreground colour used as a background — for inverted blocks that flip the page around."
    },
    "white": {
      "$type": "color",
      "$value": "{color.white}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-white",
          "sassMap": "$theme-bgs",
          "sassKey": "white",
          "sassQuoted": true
        }
      },
      "$description": "Fixed white in both schemes. Use it when a surface must not follow the theme."
    },
    "black": {
      "$type": "color",
      "$value": "{color.black}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-black",
          "sassMap": "$theme-bgs",
          "sassKey": "black",
          "sassQuoted": true
        }
      },
      "$description": "Fixed black in both schemes. Use it when a surface must not follow the theme."
    },
    "transparent": {
      "$type": "color",
      "$value": "transparent",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-transparent",
          "sassMap": "$theme-bgs",
          "sassKey": "transparent",
          "sassQuoted": true,
          "css": true
        }
      },
      "$description": "No background at all. Use it to clear an inherited one."
    },
    "inherit": {
      "$type": "color",
      "$value": "inherit",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--bg-inherit",
          "sassMap": "$theme-bgs",
          "sassKey": "inherit",
          "sassQuoted": true,
          "css": true
        }
      },
      "$description": "Take whatever background the parent has. A CSS-wide keyword, so it cannot be stored in a custom property."
    },
    "$extensions": {
      "dev.bootstrap.tokens": {
        "order": [
          "body",
          "1",
          "2",
          "3",
          "4",
          "fg",
          "white",
          "black",
          "transparent",
          "inherit"
        ]
      }
    },
    "$description": "Neutral background ramp, from the page body up through four raised surfaces."
  },
  "fg": {
    "1": {
      "$type": "color",
      "$value": "{color.gray.800}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-1",
          "sassMap": "$theme-fgs",
          "sassKey": "1",
          "sassQuoted": true,
          "dark": "{color.gray.200}"
        }
      },
      "$description": "Slightly de-emphasised text — secondary lines that still have to be read comfortably."
    },
    "2": {
      "$type": "color",
      "$value": "{color.gray.700}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-2",
          "sassMap": "$theme-fgs",
          "sassKey": "2",
          "sassQuoted": true,
          "dark": "{color.gray.300}"
        }
      },
      "$description": "Supporting text: captions, helper text under a field, table metadata."
    },
    "3": {
      "$type": "color",
      "$value": "{color.gray.600}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-3",
          "sassMap": "$theme-fgs",
          "sassKey": "3",
          "sassQuoted": true,
          "dark": "{color.gray.500}"
        }
      },
      "$description": "Faint text for labels and placeholders. Below WCAG AA for body copy, so keep it off long prose."
    },
    "4": {
      "$type": "color",
      "$value": "{color.gray.500}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-4",
          "sassMap": "$theme-fgs",
          "sassKey": "4",
          "sassQuoted": true,
          "dark": "{color.gray.600}"
        }
      },
      "$description": "The faintest step, for decorative or disabled text only. It does not meet WCAG AA at any size."
    },
    "body": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-body",
          "sassMap": "$theme-fgs",
          "sassKey": "body",
          "sassQuoted": true,
          "dark": "{color.gray.050}"
        }
      },
      "$description": "Primary body text. The default reading colour."
    },
    "bg": {
      "$type": "color",
      "$value": "{bg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-bg",
          "sassMap": "$theme-fgs",
          "sassKey": "bg",
          "sassQuoted": true
        }
      },
      "$description": "The page background used as a text colour — for text on an inverted surface."
    },
    "white": {
      "$type": "color",
      "$value": "{color.white}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-white",
          "sassMap": "$theme-fgs",
          "sassKey": "white",
          "sassQuoted": true
        }
      },
      "$description": "Fixed white in both schemes, for text that must stay light whatever the theme does."
    },
    "black": {
      "$type": "color",
      "$value": "{color.black}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-black",
          "sassMap": "$theme-fgs",
          "sassKey": "black",
          "sassQuoted": true
        }
      },
      "$description": "Fixed black in both schemes, for text that must stay dark whatever the theme does."
    },
    "inherit": {
      "$type": "color",
      "$value": "inherit",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--fg-inherit",
          "sassMap": "$theme-fgs",
          "sassKey": "inherit",
          "sassQuoted": true,
          "css": true
        }
      },
      "$description": "Take whatever text colour the parent has."
    },
    "$extensions": {
      "dev.bootstrap.tokens": {
        "order": [
          "body",
          "1",
          "2",
          "3",
          "4",
          "bg",
          "white",
          "black",
          "inherit"
        ]
      }
    },
    "$description": "Neutral foreground ramp, from primary body text down to the faintest."
  }
}
