{
  "border": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-width",
          "sassVar": "$border-width",
          "sassEmit": "#{$border-width}"
        }
      },
      "$description": "The default border width. Components reference it rather than hard-coding 1px."
    },
    "style": {
      "$value": "solid",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-style",
          "sassVar": "$border-style",
          "sassEmit": "#{$border-style}",
          "css": true
        }
      },
      "$description": "The default border style. Every component reads it, so switching to `dashed` restyles the whole system rather than one element."
    },
    "bg": {
      "$type": "color",
      "$value": "{bg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-bg",
          "sassMap": "$theme-borders",
          "sassKey": "bg",
          "sassQuoted": true
        }
      },
      "$description": "A border the colour of the page — used to punch a gap between adjacent filled elements."
    },
    "body": {
      "$value": "{color.gray.300}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-body",
          "sassMap": "$theme-borders",
          "sassKey": "body",
          "sassQuoted": true,
          "dark": "{color.gray.800}"
        }
      },
      "$description": "The standard visible border. Stronger than `subtle`, calmer than `emphasized`."
    },
    "muted": {
      "$value": "{color.gray.200}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-muted",
          "sassMap": "$theme-borders",
          "sassKey": "muted",
          "sassQuoted": true,
          "dark": "{color.gray.800}"
        }
      },
      "$description": "A quieter border for grouping without drawing a line the eye stops at."
    },
    "subtle": {
      "$value": "color-mix(in oklch, {color.gray.100}, {color.gray.200})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-subtle",
          "sassMap": "$theme-borders",
          "sassKey": "subtle",
          "sassQuoted": true,
          "dark": "color-mix(in oklch, {color.gray.800}, {color.gray.900})",
          "expression": true
        }
      },
      "$description": "The faintest border. For separating areas that are already distinguished by space."
    },
    "emphasized": {
      "$value": "{color.gray.400}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-emphasized",
          "sassMap": "$theme-borders",
          "sassKey": "emphasized",
          "sassQuoted": true,
          "dark": "{color.gray.600}"
        }
      },
      "$description": "A deliberately visible border, for focus targets and selected states."
    },
    "white": {
      "$value": "{color.white}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-white",
          "sassMap": "$theme-borders",
          "sassKey": "white",
          "sassQuoted": true
        }
      },
      "$description": "Fixed white in both schemes, for an edge that must stay light whatever the theme does."
    },
    "black": {
      "$value": "{color.black}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-black",
          "sassMap": "$theme-borders",
          "sassKey": "black",
          "sassQuoted": true
        }
      },
      "$description": "Fixed black in both schemes, for an edge that must stay dark whatever the theme does."
    },
    "width-keyline": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "px"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-width-keyline",
          "sassMap": "$root-tokens",
          "sassKey": "--border-width-keyline"
        }
      },
      "$description": "A sub-pixel hairline for dividers that should read as a seam rather than a border."
    },
    "color": {
      "$type": "color",
      "$value": "{color.gray.200}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-color",
          "sassMap": "$root-tokens",
          "sassKey": "--border-color",
          "dark": "{color.gray.700}"
        }
      },
      "$description": "The default border colour, for anything that does not choose a more specific one."
    },
    "color-translucent": {
      "$type": "color",
      "$value": "color-mix(in oklch, {fg.body} 15%, transparent)",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--border-color-translucent",
          "sassMap": "$root-tokens",
          "sassKey": "--border-color-translucent",
          "expression": true
        }
      },
      "$description": "A border mixed from the foreground rather than a fixed grey, so it works over any surface underneath."
    },
    "$description": "Default border width, style and colour, plus the neutral border ramp."
  }
}
