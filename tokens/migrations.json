      "to": "datepicker.font-size"
    },
    {
      "from": "calendar.header-font-weight",
      "to": "datepicker.header-font-weight"
    },
    {
      "from": "calendar.weekday-color",
      "to": "datepicker.weekday-color"
    },
    {
      "from": "calendar.day-hover-bg",
      "to": "datepicker.day-hover-bg"
    },
    {
      "from": "calendar.day-selected-bg",
      "to": "datepicker.day-selected-bg"
    },
    {
      "from": "calendar.day-selected-color",
      "to": "datepicker.day-selected-color"
    },
    {
      "from": "calendar.day-today-bg",
      "to": "datepicker.day-today-bg"
    },
    {
      "from": "calendar.day-today-color",
      "to": "datepicker.day-today-color"
