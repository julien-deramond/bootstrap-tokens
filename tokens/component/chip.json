{
  "chip": {
    "height": {
      "$type": "dimension",
      "$value": {
        "value": 1.75,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-height",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-height"
        }
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": {
        "value": 0.625,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-padding-x",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-padding-x"
        }
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": {
        "value": 0.3125,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-gap",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-gap"
        }
      }
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.pill}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-border-radius",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-border-radius"
        }
      }
    },
    "img-size": {
      "$type": "dimension",
      "$value": {
        "value": 1.25,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-img-size",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-img-size"
        }
      }
    },
    "icon-size": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-icon-size",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-icon-size"
        }
      }
    },
    "dismiss-size": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-dismiss-size",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-dismiss-size"
        }
      }
    },
    "dismiss-opacity": {
      "$type": "number",
      "$value": 0.65,
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-dismiss-opacity",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-dismiss-opacity"
        }
      }
    },
    "dismiss-hover-opacity": {
      "$type": "number",
      "$value": 1,
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-dismiss-hover-opacity",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-dismiss-hover-opacity"
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": "var(--theme-fg, {fg.body})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-color",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-color",
          "expression": true
        }
      }
    },
    "bg": {
      "$type": "color",
      "$value": "var(--theme-bg-subtle, {bg.2})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-bg",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-bg",
          "expression": true
        }
      }
    },
    "border-color": {
      "$type": "color",
      "$value": "transparent",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-border-color",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-border-color",
          "css": true
        }
      }
    },
    "selected-color": {
      "$type": "color",
      "$value": "var(--theme-contrast, {theme-color.primary.contrast})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-selected-color",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-selected-color",
          "expression": true
        }
      }
    },
    "selected-bg": {
      "$type": "color",
      "$value": "var(--theme-bg, {theme-color.primary.bg})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-selected-bg",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-selected-bg",
          "expression": true
        }
      }
    },
    "selected-border-color": {
      "$type": "color",
      "$value": "var(--theme-bg, {theme-color.primary.bg})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--chip-selected-border-color",
          "sassMap": "$chip-tokens",
          "sassKey": "--chip-selected-border-color",
          "expression": true
        }
      }
    },
    "$description": "Tokens emitted on `.chip`.",
    "$extensions": {
      "dev.bootstrap.tokens": {
        "sassMap": "$chip-tokens",
        "selector": ".chip",
        "source": "scss/_chip.scss"
      }
    }
  }
}
