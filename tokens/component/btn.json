{
  "btn": {
    "gap": {
      "$type": "dimension",
      "$value": "{control.field.gap}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-gap",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-gap",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-gap)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-gap)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-gap)"
            }
          ]
        }
      }
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{control.field.min-height}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-min-height",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-min-height",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-min-height)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-min-height)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-min-height)"
            }
          ]
        }
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{control.field.padding-x}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-padding-x",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-padding-x",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-padding-x)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-padding-x)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-padding-x)"
            }
          ]
        }
      }
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{control.field.padding-y}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-padding-y",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-padding-y",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-padding-y)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-padding-y)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-padding-y)"
            }
          ]
        }
      }
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{control.field.font-size}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-font-size",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-font-size",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-font-size)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-font-size)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-font-size)"
            }
          ]
        }
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{control.field.font-weight}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-font-weight",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-font-weight",
          "redeclared": [
            {
              "selector": ".btn-link",
              "token": "button-link.btn-font-weight"
            }
          ]
        }
      }
    },
    "line-height": {
      "$type": "dimension",
      "$value": "{control.field.line-height}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-line-height",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-line-height",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-line-height)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-line-height)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-line-height)"
            }
          ]
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": "{fg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-color",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-color",
          "redeclared": [
            {
              "selector": ".btn-solid",
              "value": "var(--theme-contrast)"
            },
            {
              "selector": ".btn-outline",
              "value": "var(--theme-fg)"
            },
            {
              "selector": ".btn-subtle",
              "value": "var(--theme-fg)"
            },
            {
              "selector": ".btn-text",
              "value": "var(--theme-fg)"
            },
            {
              "selector": ".btn-link",
              "token": "button-link.btn-color"
            }
          ]
        }
      }
    },
    "white-space": {
      "$value": "nowrap",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-white-space",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-white-space",
          "css": true
        }
      }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-border-width",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-border-width"
        }
      }
    },
    "border-color": {
      "$type": "color",
      "$value": "transparent",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-border-color",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-border-color",
          "css": true,
          "redeclared": [
            {
              "selector": ".btn-solid",
              "value": "var(--theme-bg)"
            },
            {
              "selector": ".btn-outline",
              "value": "var(--theme-border)"
            },
            {
              "selector": ".btn-subtle",
              "value": "transparent"
            },
            {
              "selector": ".btn-text",
              "value": "transparent"
            },
            {
              "selector": ".btn-link",
              "token": "button-link.btn-border-color"
            }
          ]
        }
      }
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.5}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-border-radius",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-border-radius",
          "redeclared": [
            {
              "selector": ".btn-xs, .btn-group-xs > [class*=btn-]",
              "value": "var(--btn-input-xs-border-radius)"
            },
            {
              "selector": ".btn-sm, .btn-group-sm > [class*=btn-]",
              "value": "var(--btn-input-sm-border-radius)"
            },
            {
              "selector": ".btn-lg, .btn-group-lg > [class*=btn-]",
              "value": "var(--btn-input-lg-border-radius)"
            }
          ]
        }
      }
    },
    "hover-border-color": {
      "$type": "color",
      "$value": "transparent",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-hover-border-color",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-hover-border-color",
          "css": true,
          "redeclared": [
            {
              "selector": ".btn-solid:hover",
              "value": "oklch(from var(--theme-bg) calc(l * .95) calc(c * 1.1) h)"
            },
            {
              "selector": ".btn-outline:hover",
              "value": "oklch(from var(--theme-bg) calc(l * .95) calc(c * 1.1) h)"
            },
            {
              "selector": ".btn-link",
              "token": "button-link.btn-hover-border-color"
            }
          ]
        }
      }
    },
    "disabled-opacity": {
      "$type": "number",
      "$value": 0.65,
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-disabled-opacity",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-disabled-opacity"
        }
      }
    },
    "transition-property": {
      "$value": "\"color, background-color, border-color, box-shadow\"",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-transition-property",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-transition-property",
          "css": true
        }
      }
    },
    "transition-duration": {
      "$type": "duration",
      "$value": {
        "value": 0.15,
        "unit": "s"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-transition-duration",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-transition-duration"
        }
      }
    },
    "transition-timing": {
      "$type": "cubicBezier",
      "$value": "ease-in-out",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--btn-transition-timing",
          "sassMap": "$button-tokens",
          "sassKey": "--btn-transition-timing",
          "css": true
        }
      }
    },
    "$description": "Tokens emitted on `.btn`.",
    "$extensions": {
      "dev.bootstrap.tokens": {
        "sassMap": "$button-tokens",
        "selector": ".btn",
        "source": "scss/buttons/_button.scss",
        "cascade": {
          "layer": "components",
          "rule": ".btn, .btn-link, .btn-icon, .btn-solid, .btn-outline, .btn-subtle, .btn-text"
        }
      }
    }
  }
}
