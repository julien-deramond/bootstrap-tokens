        "dev.bootstrap.tokens": {
          "cssVar": "--badge-color",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-color",
          "css": true
        }
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{bg.2}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--badge-bg",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-bg"
