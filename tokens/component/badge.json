    "gap": {
      "$type": "dimension",
      "$value": ".375em",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--badge-gap",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-gap",
          "css": true
        }
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": ".625em",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--badge-padding-x",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-padding-x",
          "css": true
        }
      }
    },
    "padding-y": {
      "$type": "dimension",
      "$value": ".25em",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--badge-padding-y",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-padding-y",
          "css": true
        }
      }
    },
    "font-size": {
      "$type": "dimension",
      "$value": "clamp(12px, .75em, .75em)",
      "$extensions": {
