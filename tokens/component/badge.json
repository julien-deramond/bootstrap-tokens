      "$type": "dimension",
      "$value": "{radius.7}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--badge-border-radius",
          "sassMap": "$badge-tokens",
          "sassKey": "--badge-border-radius"
