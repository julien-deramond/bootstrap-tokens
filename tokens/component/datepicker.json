{
  "datepicker": {
    "padding": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-padding",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-padding"
        }
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{bg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-bg",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-bg"
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": "{fg.body}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-color"
        }
      }
    },
    "border-color": {
      "$type": "color",
      "$value": "{border.color-translucent}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-border-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-border-color"
        }
      }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-border-width",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-border-width"
        }
      }
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.7}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-border-radius",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-border-radius"
        }
      }
    },
    "box-shadow": {
      "$type": "shadow",
      "$value": "{shadow.default}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-box-shadow",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-box-shadow"
        }
      }
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font-size.sm}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-font-size",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-font-size"
        }
      }
    },
    "transition-property": {
      "$value": "\"opacity, transform\"",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-transition-property",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-transition-property",
          "css": true
        }
      }
    },
    "transition-duration": {
      "$type": "duration",
      "$value": {
        "value": 0.15,
        "unit": "s"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-transition-duration",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-transition-duration"
        }
      }
    },
    "transition-timing": {
      "$type": "cubicBezier",
      "$value": "{motion.timing-overlay}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-transition-timing",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-transition-timing"
        }
      }
    },
    "min-width": {
      "$type": "dimension",
      "$value": {
        "value": 280,
        "unit": "px"
      },
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-min-width",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-min-width"
        }
      }
    },
    "zindex": {
      "$type": "number",
      "$value": "{z-index.menu}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-zindex",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-zindex"
        }
      }
    },
    "header-font-weight": {
      "$type": "fontWeight",
      "$value": "{font-weight.semibold}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-header-font-weight",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-header-font-weight"
        }
      }
    },
    "weekday-color": {
      "$type": "color",
      "$value": "{fg.3}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-weekday-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-weekday-color"
        }
      }
    },
    "day-hover-bg": {
      "$type": "color",
      "$value": "{bg.1}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-hover-bg",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-hover-bg"
        }
      }
    },
    "day-selected-bg": {
      "$type": "color",
      "$value": "var(--theme-bg, {theme-color.primary.bg})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-selected-bg",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-selected-bg",
          "expression": true
        }
      },
      "$description": "Follows the `.theme-*` class on an ancestor through `--theme-bg`, and uses the fallback only when no theme class is set."
    },
    "day-selected-color": {
      "$type": "color",
      "$value": "var(--theme-contrast, {theme-color.primary.contrast})",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-selected-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-selected-color",
          "expression": true
        }
      },
      "$description": "Follows the `.theme-*` class on an ancestor through `--theme-contrast`, and uses the fallback only when no theme class is set."
    },
    "day-today-bg": {
      "$type": "color",
      "$value": "{bg.2}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-today-bg",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-today-bg"
        }
      }
    },
    "day-today-color": {
      "$type": "color",
      "$value": "{fg.1}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-today-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-today-color"
        }
      }
    },
    "day-disabled-color": {
      "$type": "color",
      "$value": "{fg.4}",
      "$extensions": {
        "dev.bootstrap.tokens": {
          "cssVar": "--datepicker-day-disabled-color",
          "sassMap": "$datepicker-tokens",
          "sassKey": "--datepicker-day-disabled-color"
        }
      }
    },
    "$description": "Tokens emitted on `[data-vc=calendar]`.",
    "$extensions": {
      "dev.bootstrap.tokens": {
        "sassMap": "$datepicker-tokens",
        "selector": "[data-vc=calendar]",
        "source": "scss/forms/_datepicker.scss",
        "cascade": {
          "layer": "components",
          "rule": "[data-vc=calendar]"
        }
      }
    }
  }
}
